        subprocess.run([
            "openssl", "req", "-x509", "-newkey", "rsa:2048",
            "-keyout", Config.SSL_KEY,
            "-out", Config.SSL_CERT,
            "-days", "365", "-nodes",
            "-subj", "/CN=localhost"
        ])
        print("[✓] Certificat SSL généré")
    
    app.run(
        host=Config.HOST,
        port=Config.PORT,
        ssl_context=(Config.SSL_CERT, Config.SSL_KEY),
        debug=False,
        threaded=True
    )
